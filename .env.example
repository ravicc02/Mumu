# OpenAI-compatible chat completions endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_REASONING_EFFORT=

# Set to true when the provider supports response_format={"type":"json_object"}.
OPENAI_JSON_MODE=false

# When true, or when OPENAI_API_KEY is empty, the server returns clearly marked demo answers.
AI_MOCK=false

HOST=127.0.0.1
PORT=8787
AI_TIMEOUT_MS=60000
