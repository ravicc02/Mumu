# OpenAI-compatible chat completions endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODEL=
AI_REASONING_EFFORT=high

# Desktop backend.
ANSWER_STUDIO_HOST=127.0.0.1
ANSWER_STUDIO_PORT=8877
ANSWER_STUDIO_DATA=
ANSWER_STUDIO_CHROME_PATH=

# Optional WeChat iLink Bot binding. The desktop UI can also bind by QR code.
WEIXIN_BOT_TOKEN=
WEIXIN_USER_ID=
WEIXIN_CONTEXT_TOKEN=
WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com

# Legacy Chrome extension server.
HOST=127.0.0.1
PORT=8787
AI_TIMEOUT_MS=60000
OPENAI_JSON_MODE=false
AI_MOCK=false
