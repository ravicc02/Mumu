{
  "name": "ai-assignment-studio-desktop",
  "version": "0.5.0-rc.3",
  "description": "Local Windows assignment automation studio",
  "author": "AI Assignment Studio Contributors",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "web": "vite",
    "test": "node --test test/*.test.mjs",
    "prebuild:web": "node ../scripts/version.mjs check",
    "build:web": "vite build",
    "build:backend": "powershell -ExecutionPolicy Bypass -File ../scripts/build-backend.ps1",
    "prebuild:win": "node ../scripts/release.mjs check",
    "build:win": "vite build && npm run build:backend && electron-builder --win nsis --x64 --publish never",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "^1.72.0",
    "cannon-es": "^0.20.0",
    "jsqr": "^1.4.0",
    "open-mascot": "file:../third_party/open-mascot",
    "pathfinding": "0.4.18",
    "qrcode": "^1.5.4",
    "three": "^0.187.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "local.ai.assignment.studio",
    "productName": "AI Assignment Studio",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/answer-studio-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "artifactName": "Assignment-Studio-${version}-windows-${arch}-setup.${ext}",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
