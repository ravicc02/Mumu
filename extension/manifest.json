{
  "manifest_version": 3,
  "name": "AI 答题助手（预览版）",
  "version": "0.1.1",
  "minimum_chrome_version": "114",
  "description": "扫描当前页面题目，调用本地 AI 服务生成答案，并在确认后填入页面。",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开 AI 答题助手"
  }
}
